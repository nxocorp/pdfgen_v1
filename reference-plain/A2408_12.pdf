><speak
>d a form 24 o 8 dash 12, march 2014.&#xD;edition of january 92 is obsolete.&#xD;a p d. l c version 1.00.&#xD;army aviators flight record.&#xD;for use of this form, see d a pamphlet 7 38 dash 7 51, the proponent agency is d c s g dash 4.&#xD;enter current page number.</speak
></assist
><event activity="change" name="event__change"
><script contentType="application/x-javascript"
>
xfa.event.change = validateUserInput(xfa.event.change, "0123456789-");

function validateUserInput(enteredText, validChars){
	enteredText = String(enteredText);
	var numbers = String(validChars);
	var correctedText = "";
	var size = enteredText.length;
	
	for(var i = 0; i &lt; size; i++){
		var ch = enteredText.charAt(i);
		if (numbers.indexOf(ch) != -1){
			correctedText += ch;
		}
	}
	return correctedText;		
}
</script
></event
