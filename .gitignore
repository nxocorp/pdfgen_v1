# Dependencies (npm install from server/package.json)
node_modules/

# Local SQLite database — server/db.js seeds this fresh on first boot
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Ad-hoc data-repair backups made directly against a live database
# (see history.md for when/why these get created)
*.backup.json

# Local npm proxy/auth config for the corporate network — contains a live
# Nexus auth token, never commit this (see CLAUDE.md's "Local dev setup"
# note for the proxy env-var alternative that doesn't require a secret file)
.npmrc
